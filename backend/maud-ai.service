# Install to /etc/systemd/system/maud-ai.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maud-ai
[Unit]
Description=maud-ai RAG API (Qdrant + vLLM) for the VOA-GNY chat bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skunk
WorkingDirectory=/opt/maud-ai
Environment="PATH=/opt/maud-ai/venv/bin:/usr/bin:/bin"
Environment="QDRANT_HOST=localhost"
Environment="QDRANT_PORT=6333"
Environment="QDRANT_COLLECTION=hr-documents"
Environment="VLLM_BASE_URL=http://localhost:8000/v1"
Environment="MODEL_NAME=google/gemma-3-1b-it"
Environment="EMBEDDING_MODEL=BAAI/bge-base-en-v1.5"
Environment="EMBEDDING_DEVICE=cpu"
Environment="HOST=0.0.0.0"
Environment="PORT=8100"
ExecStart=/opt/maud-ai/venv/bin/uvicorn maud_service.main:app --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
