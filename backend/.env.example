# Copy to backend/.env and source it, or set these in the systemd unit.

# --- Qdrant ---------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hr-documents

# --- Embeddings -----------------------------------------------------------
# Must match the model ingest_documents.py used to build the collection.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# --- vLLM -----------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=google/gemma-3-1b-it
LLM_TIMEOUT_SECONDS=180

# --- Retrieval / generation budgets --------------------------------------
# Sized for vLLM's --max-model-len 2048. Raise together if you restart vLLM
# with a larger window.
MAX_CONTEXT_CHARS=2600
MAX_OUTPUT_TOKENS=256
MAX_HISTORY_TURNS=2
MAX_HISTORY_CHARS=400
MAX_CONTEXT_CHUNKS=5
PTO_CONTEXT_CHUNKS=4
SEARCH_LIMIT=10

# --- Service --------------------------------------------------------------
HOST=0.0.0.0
PORT=8100
# Comma-separated. Only needed if a browser calls this service directly;
# the Next.js frontend proxies server-side.
CORS_ORIGINS=*
