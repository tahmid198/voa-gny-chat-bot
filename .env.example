# ---------------------------------------------------------------------------
# Jetson Nano / Ollama
# ---------------------------------------------------------------------------
# The Jetson is at admin@192.168.3.153. Ollama listens on port 11434.
# NOTE: by default Ollama only binds to 127.0.0.1. To reach it from this app,
# SSH into the Jetson and set OLLAMA_HOST=0.0.0.0 for the ollama service:
#   sudo systemctl edit ollama
#   [Service]
#   Environment="OLLAMA_HOST=0.0.0.0:11434"
#   sudo systemctl restart ollama
JETSON_IP=192.168.3.153
JETSON_SSH_USER=admin

# Full base URL the app uses to talk to Ollama. Change the IP here if the
# Jetson moves to a different address.
OLLAMA_HOST=http://192.168.3.153:11434

# The model to run. Must already be pulled on the Jetson (`ollama pull <model>`).
# Jetson Nano has limited RAM, so a small model is recommended.
OLLAMA_MODEL=llama3.2:3b

# How long to wait for the Jetson to respond, in milliseconds.
OLLAMA_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------
# Folder the backend reads. Relative paths resolve from the project root.
DOCS_DIR=./documents

# Skip files larger than this (MB) during indexing.
MAX_FILE_SIZE_MB=25

# How many document chunks to feed the model as context per question.
MAX_CONTEXT_CHUNKS=8
