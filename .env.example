# ---------------------------------------------------------------------------
# maud-ai backend
# ---------------------------------------------------------------------------
# This app is a frontend only. Retrieval (Qdrant + BAAI/bge-base-en-v1.5) and
# generation (vLLM serving google/gemma-3-1b-it) both run in the maud-ai
# service on the Ubuntu host — see backend/README.md for deploying it.

# Host running /opt/maud-ai.
MAUD_HOST=10.10.1.165

# Full base URL of the maud-ai FastAPI service. Change this if it moves, or
# if you tunnel it (e.g. http://localhost:8100 with an SSH port-forward).
MAUD_API_URL=http://10.10.1.165:8100

# How long to wait for an answer, in milliseconds. Generous, because a cold
# vLLM loads the model before it emits the first token.
MAUD_CHAT_TIMEOUT_MS=300000

# Timeout for the health / document-list calls behind the status indicator.
MAUD_STATUS_TIMEOUT_MS=10000
